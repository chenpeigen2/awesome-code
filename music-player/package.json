{
  "name": "music-player",
  "version": "1.0.0",
  "description": "A desktop music player built with Electron, React and TypeScript",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "preview": "vite preview",
    "start": "npm run build:electron && concurrently \"npm run dev\" \"wait-on http://localhost:5173 && npx electron .\"",
    "start:win": "powershell -ExecutionPolicy Bypass -File ./start.ps1",
    "start:win-cmd": "start.bat",
    "start:mac": "chmod +x ./start.sh && ./start.sh",
    "start:linux": "chmod +x ./start.sh && ./start.sh",
    "electron:dev": "concurrently \"npm run build:electron && tsc -p electron/tsconfig.json -w\" \"vite\" \"wait-on http://localhost:5173 && wait-on dist/electron/main.js && electron .\"",
    "electron:build": "npm run build:electron && vite build && electron-builder",
    "electron:build:win": "npm run build:electron && vite build && electron-builder --win",
    "electron:build:mac": "npm run build:electron && vite build && electron-builder --mac",
    "electron:build:linux": "npm run build:electron && vite build && electron-builder --linux",
    "lint": "eslint src --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "howler": "^2.2.4",
    "lucide-react": "^1.74.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/howler": "^2.2.11",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "concurrently": "^10.0.7",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "jsdom": "^31.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.musicplayer.app",
    "productName": "Music Player",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
