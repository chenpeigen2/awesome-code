<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.JNIDemo">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 基础示例 -->
        <activity android:name=".basic.BasicCallActivity" />
        <activity android:name=".basic.ParamPassingActivity" />
        <activity android:name=".basic.ArrayOperationActivity" />

        <!-- 进阶示例 -->
        <activity android:name=".intermediate.ObjectManipulationActivity" />
        <activity android:name=".intermediate.CallbackActivity" />
        <activity android:name=".intermediate.FileIOActivity" />

        <!-- 高级示例 -->
        <activity android:name=".advanced.DynamicRegisterActivity" />
        <activity android:name=".advanced.ThreadCallbackActivity" />

        <!-- Rust JNI 示例 -->
        <activity android:name=".rust.RustJniActivity" />

    </application>

</manifest>
